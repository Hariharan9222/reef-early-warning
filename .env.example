# CoralGuard Configuration Template (.env.example)

# External Satellite / Earth Observation Auth (Optional)
CMEMS_USERNAME=
CMEMS_PASSWORD=
KAGGLE_USERNAME=
KAGGLE_KEY=
HF_TOKEN=
NASA_EARTHDATA_TOKEN=

# Database Configuration (PostgreSQL+PostGIS with zero-config SQLite fallback)
DATABASE_URL=sqlite:///./data/coralguard.db
# DATABASE_URL=postgresql+psycopg2://coralguard:secret@localhost:5432/coralguard_db

# Redis Cache (Set to "disabled" to use built-in thread-safe in-memory TTL cache)
REDIS_URL=disabled
CACHE_DEFAULT_TTL=3600

# NOAA Coral Reef Watch ERDDAP
NOAA_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap/griddap/NOAA_DHW.csv
ERDDAP_TIMEOUT_SEC=15
ERDDAP_MAX_RETRIES=3

# Ingestion Background Scheduler (APScheduler)
SCHEDULER_ENABLED=True
INGESTION_CRON_HOUR=2

# ML Model Artifacts
MODEL_T14_PATH=models/xgb_multimodal_t14.joblib
MODEL_T28_PATH=models/xgb_multimodal_t28.joblib

# Operational Alert Thresholds
WATCH_THRESHOLD=0.25
WARNING_THRESHOLD=0.50
ALERT_THRESHOLD=0.75

# Logging
LOG_LEVEL=INFO
