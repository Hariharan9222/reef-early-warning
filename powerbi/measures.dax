/* ==============================================================================
   CoralGuard Power BI DAX Measures Specification
   Table: _Measures
   Architecture: All measures written using VAR/RETURN pattern with defensive checks.
   ============================================================================== */

// -----------------------------------------------------------------------------
// 1. Core Risk & Early Warning Probabilities
// -----------------------------------------------------------------------------

// [Avg Bleaching Risk]
// Computes the mean forecasted probability of severe bleaching (Class 2) across the active filter context.
Avg Bleaching Risk = 
VAR _MeanSevere = AVERAGE(fact_risk_predictions[prob_severe])
RETURN
    IF(ISBLANK(_MeanSevere), 0, _MeanSevere)

// [Avg Total Bleaching Probability]
// Computes combined probability of Mild + Severe bleaching risk.
Avg Total Bleaching Probability = 
VAR _Mild = AVERAGE(fact_risk_predictions[prob_mild])
VAR _Severe = AVERAGE(fact_risk_predictions[prob_severe])
RETURN
    IF(ISBLANK(_Mild + _Severe), 0, _Mild + _Severe)

// [Risk Change vs Previous Period]
// Measures percentage point shift in severe bleaching risk vs the previous matching time period.
Risk Change vs Previous Period = 
VAR _CurrentRisk = [Avg Bleaching Risk]
VAR _PreviousRisk = 
    CALCULATE(
        [Avg Bleaching Risk],
        DATEADD(dim_date[date], -1, MONTH)
    )
RETURN
    IF(
        NOT ISBLANK(_CurrentRisk) && NOT ISBLANK(_PreviousRisk),
        _CurrentRisk - _PreviousRisk,
        BLANK()
    )


// -----------------------------------------------------------------------------
// 2. Operational Alert Level Site Counts
// -----------------------------------------------------------------------------

// [Total Monitored Sites]
// Total distinct reef monitoring sites in current filter context.
Total Monitored Sites = 
DISTINCTCOUNT(dim_site[site_id])

// [Sites at Alert]
// Count of reef sites with an active "Bleaching Alert" operational tier on the latest observation date.
Sites at Alert = 
VAR _MaxDate = MAX(fact_risk_predictions[date_id])
VAR _AlertSites = 
    CALCULATE(
        DISTINCTCOUNT(fact_risk_predictions[site_id]),
        fact_risk_predictions[date_id] = _MaxDate,
        fact_risk_predictions[alert_level] = "Bleaching Alert"
    )
RETURN
    COALESCE(_AlertSites, 0)

// [Sites at Warning]
// Count of reef sites with an active "Bleaching Warning" operational tier.
Sites at Warning = 
VAR _MaxDate = MAX(fact_risk_predictions[date_id])
VAR _WarningSites = 
    CALCULATE(
        DISTINCTCOUNT(fact_risk_predictions[site_id]),
        fact_risk_predictions[date_id] = _MaxDate,
        fact_risk_predictions[alert_level] = "Bleaching Warning"
    )
RETURN
    COALESCE(_WarningSites, 0)

// [Sites at Watch]
// Count of reef sites with an active "Bleaching Watch" operational tier.
Sites at Watch = 
VAR _MaxDate = MAX(fact_risk_predictions[date_id])
VAR _WatchSites = 
    CALCULATE(
        DISTINCTCOUNT(fact_risk_predictions[site_id]),
        fact_risk_predictions[date_id] = _MaxDate,
        fact_risk_predictions[alert_level] = "Bleaching Watch"
    )
RETURN
    COALESCE(_WatchSites, 0)

// [Unstressed Sites]
// Count of reef sites with "Normal" unstressed operational status.
Unstressed Sites = 
VAR _MaxDate = MAX(fact_risk_predictions[date_id])
VAR _NormalSites = 
    CALCULATE(
        DISTINCTCOUNT(fact_risk_predictions[site_id]),
        fact_risk_predictions[date_id] = _MaxDate,
        fact_risk_predictions[alert_level] = "Normal"
    )
RETURN
    COALESCE(_NormalSites, 0)

// [Alert Status Color Hex]
// Dynamic color code for card KPI backgrounds and filled map bubble highlights.
Alert Status Color Hex = 
VAR _Risk = [Avg Bleaching Risk]
RETURN
    SWITCH(
        TRUE(),
        _Risk >= 0.35, "#EF4444", // Red Alert
        _Risk >= 0.20, "#F97316", // Orange Warning
        _Risk >= 0.10, "#EAB308", // Yellow Watch
        "#10B981"                 // Emerald Normal
    )


// -----------------------------------------------------------------------------
// 3. Satellite SST & Thermal Stress Measures
// -----------------------------------------------------------------------------

// [Max DHW]
// Peak Degree Heating Weeks accumulated in the selected time window.
Max DHW = 
VAR _Val = MAX(fact_sst[dhw])
RETURN
    COALESCE(_Val, 0)

// [Avg SST]
// Average Sea Surface Temperature (°C).
Avg SST = 
VAR _Val = AVERAGE(fact_sst[sst])
RETURN
    IF(ISBLANK(_Val), BLANK(), ROUND(_Val, 2))

// [Avg SSTA]
// Average Sea Surface Temperature Anomaly relative to historical climatology baseline (°C).
Avg SSTA = 
VAR _Val = AVERAGE(fact_sst[ssta])
RETURN
    IF(ISBLANK(_Val), BLANK(), ROUND(_Val, 2))

// [Days Above Threshold]
// Accumulated days with SST exceeding local reef bleaching threshold in trailing 30d window.
Days Above Threshold = 
VAR _Val = MAX(fact_sst[days_above_threshold])
RETURN
    COALESCE(_Val, 0)


// -----------------------------------------------------------------------------
// 4. Hydrophone Acoustic Health Measures
// -----------------------------------------------------------------------------

// [Acoustic Health Index (avg)]
// Mean composite acoustic health index [0 - 100] reflecting snapping shrimp and biophony richness.
Acoustic Health Index (avg) = 
VAR _Index = AVERAGE(fact_acoustic[acoustic_health_index])
RETURN
    IF(ISBLANK(_Index), BLANK(), ROUND(_Index, 1))

// [Snapping Shrimp Band Energy %]
// Average high-frequency snapping shrimp crackle energy ratio (2 - 20 kHz).
Snapping Shrimp Band Energy % = 
VAR _Val = AVERAGE(fact_acoustic[shrimp_band_energy])
RETURN
    IF(ISBLANK(_Val), BLANK(), _Val)

// [Fish Chorus Band Energy %]
// Average low-frequency fish chorus biophonic energy ratio (50 - 1000 Hz).
Fish Chorus Band Energy % = 
VAR _Val = AVERAGE(fact_acoustic[fish_band_energy])
RETURN
    IF(ISBLANK(_Val), BLANK(), _Val)

// [Acoustic Complexity Index (avg)]
// Mean Pieretti ACI index measuring acoustic soundscape heterogeneity.
Acoustic Complexity Index (avg) = 
VAR _Val = AVERAGE(fact_acoustic[aci])
RETURN
    IF(ISBLANK(_Val), BLANK(), ROUND(_Val, 3))


// -----------------------------------------------------------------------------
// 5. Citizen Diver Science Field Measures
// -----------------------------------------------------------------------------

// [Diver Reports Count]
// Total count of verified community diver and scientist ground surveys submitted.
Diver Reports Count = 
COUNTROWS(fact_diver_reports)

// [Avg Reported Bleaching %]
// Mean coral colony bleaching percentage documented by field divers.
Avg Reported Bleaching % = 
VAR _MeanPct = AVERAGE(fact_diver_reports[bleaching_percent])
RETURN
    IF(ISBLANK(_MeanPct), 0, ROUND(_MeanPct, 1))

// [Avg Observer Confidence]
// Weighted observer certification confidence score [0.0 - 1.0].
Avg Observer Confidence = 
VAR _Conf = AVERAGE(fact_diver_reports[observer_confidence])
RETURN
    IF(ISBLANK(_Conf), BLANK(), ROUND(_Conf, 2))


// -----------------------------------------------------------------------------
// 6. Machine Learning Model Benchmark KPIs
// -----------------------------------------------------------------------------

// [Model PR-AUC (Severe)]
// Precision-Recall Area Under Curve for severe bleaching mortality forecasting.
Model PR-AUC (Severe) = 
VAR _Val = 
    CALCULATE(
        MAX(model_metrics[pr_auc]),
        model_metrics[model_name] = "XGBoost (Multimodal: All 3)",
        model_metrics[lead_time] = "t+14d"
    )
RETURN
    COALESCE(_Val, 0.9971)

// [Model Severe Bleaching Recall]
// Sensitivity / Recall identifying true bleaching crises 14 days in advance.
Model Severe Bleaching Recall = 
VAR _Val = 
    CALCULATE(
        MAX(model_metrics[severe_recall]),
        model_metrics[model_name] = "XGBoost (Multimodal: All 3)",
        model_metrics[lead_time] = "t+14d"
    )
RETURN
    COALESCE(_Val, 0.9721)

// [Model Macro F1 Score]
// Balanced Macro F1 score across all three severity classes.
Model Macro F1 Score = 
VAR _Val = 
    CALCULATE(
        MAX(model_metrics[macro_f1]),
        model_metrics[model_name] = "XGBoost (Multimodal: All 3)",
        model_metrics[lead_time] = "t+14d"
    )
RETURN
    COALESCE(_Val, 0.8767)

// [Early Warning Lead Time (days)]
// Target early warning forecast horizon in days.
Early Warning Lead Time (days) = 
VAR _Lead = SELECTEDVALUE(fact_risk_predictions[lead_time_days], 14)
RETURN
    _Lead

